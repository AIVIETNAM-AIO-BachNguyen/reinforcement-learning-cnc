generator client {
  provider = "prisma-client-js"
}

model FactorySnapshot {
  factory Factory @relation(fields: [factoryId], references: [factoryId], onDelete: Restrict, onUpdate: Restrict)
  factoryId String @map("factory_id")
  snapshotId String @map("snapshot_id")
  sourceId String? @map("source_id")
  schemaVersion String @map("schema_version")
  contentHash String @map("content_hash") @db.Char(64)
  payloadJson Json @map("payload_json") @db.JsonB
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  schedules OperationSchedule[]
  heads OperationsHead[]

  decisionCases DecisionCase[]

  @@id([factoryId, snapshotId])
  @@map("factory_snapshots")
}

model OperationSchedule {
  factoryId String @map("factory_id")
  scheduleId String @map("schedule_id")
  revision Int
  snapshotId String @map("snapshot_id")
  schemaVersion String @map("schema_version")
  contentHash String @map("content_hash") @db.Char(64)
  payloadJson Json @map("payload_json") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  snapshot FactorySnapshot @relation(fields: [factoryId, snapshotId], references: [factoryId, snapshotId], onDelete: Restrict)
  heads OperationsHead[]
  commit DecisionCommit?

  @@id([factoryId, scheduleId, revision])
  @@unique([factoryId, snapshotId, scheduleId, revision], map: "operation_schedules_snapshot_schedule_key")
  @@map("operation_schedules")
}

model OperationsHead {
  factoryId String @id @map("factory_id")
  snapshotId String @map("snapshot_id")
  scheduleId String? @map("schedule_id")
  scheduleRevision Int? @map("schedule_revision")
  planVersion Int @default(0) @map("plan_version")
  revision Int @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  snapshot FactorySnapshot @relation(fields: [factoryId, snapshotId], references: [factoryId, snapshotId], onDelete: Restrict)
  schedule OperationSchedule? @relation(fields: [factoryId, scheduleId, scheduleRevision], references: [factoryId, scheduleId, revision], onDelete: Restrict, map: "operations_heads_schedule_fkey")

  @@map("operations_heads")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DecisionCase {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factoryId String @map("factory_id")
  snapshotId String @map("snapshot_id")
  basePlanVersion Int @map("base_plan_version")
  mode String
  status String @default("CREATED")
  revision Int @default(1)
  requestJson Json @map("request_json") @db.JsonB
  requestHash String @map("request_hash") @db.Char(64)
  actorId String @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  processingStatus String @default("PENDING") @map("processing_status")
  processingAttempt Int @default(0) @map("processing_attempt")
  processingErrorCode String? @map("processing_error_code")
  leaseToken String? @map("lease_token") @db.Uuid
  leaseOwnerId String? @map("lease_owner_id") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  recommendation DecisionRecommendationArtifact?
  humanDecision DecisionHumanRecord?
  commit DecisionCommit?
  snapshot FactorySnapshot @relation(fields: [factoryId, snapshotId], references: [factoryId, snapshotId], onDelete: Restrict, onUpdate: Restrict)
  events DecisionCaseEvent[]
  receipts DecisionCaseIdempotencyReceipt[]
  @@index([factoryId, createdAt])
  @@index([factoryId, createdAt(sort: Desc), id(sort: Desc)], map: "decision_cases_factory_created_id_desc_idx")
  @@unique([id, factoryId], map: "decision_cases_id_factory_key")
  @@unique([id, snapshotId])
  @@map("decision_cases")
}

model DecisionHumanRecord {
  caseId String @id @map("case_id") @db.Uuid
  decision String
  recommendationId String @map("recommendation_id")
  candidateId String? @map("candidate_id")
  candidateVersion Int? @map("candidate_version")
  candidateHash String? @map("candidate_hash") @db.Char(64)
  scheduleHash String? @map("schedule_hash") @db.Char(64)
  note String?
  actorId String @map("actor_id") @db.Uuid
  decidedAt DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)
  case DecisionCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recommendation DecisionRecommendationArtifact @relation(fields: [recommendationId], references: [recommendationId], onDelete: NoAction, onUpdate: NoAction)
  @@map("decision_human_records")
}

model DecisionCommit {
  workOrders WorkOrder[]
  caseId String @id @map("case_id") @db.Uuid
  factoryId String @map("factory_id")
  snapshotId String @map("snapshot_id")
  scheduleId String @map("schedule_id")
  scheduleRevision Int @map("schedule_revision")
  scheduleHash String @map("schedule_hash") @db.Char(64)
  planVersion Int @map("plan_version")
  actorId String @map("actor_id") @db.Uuid
  committedAt DateTime @default(now()) @map("committed_at") @db.Timestamptz(6)
  case DecisionCase @relation(fields: [caseId, factoryId], references: [id, factoryId], onDelete: Restrict, onUpdate: Restrict, map: "decision_commits_case_factory_fkey")
  schedule OperationSchedule @relation(fields: [factoryId, snapshotId, scheduleId, scheduleRevision], references: [factoryId, snapshotId, scheduleId, revision], onDelete: Restrict, onUpdate: Restrict)
  @@unique([factoryId, scheduleId, scheduleRevision])
  @@unique([factoryId, snapshotId, scheduleId, scheduleRevision])
  @@unique([caseId, factoryId], map: "decision_commits_case_factory_key")
  @@unique([factoryId, planVersion])
  @@unique([caseId, factoryId, snapshotId, scheduleId, scheduleRevision, scheduleHash, planVersion], map: "decision_commits_work_order_source_key")
  @@map("decision_commits")
}

model DecisionCaseEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId String @map("case_id") @db.Uuid
  sequence Int
  type String
  actorId String @map("actor_id") @db.Uuid
  actorKind String @default("HUMAN") @map("actor_kind")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  payloadJson Json @map("payload_json") @db.JsonB
  case DecisionCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([caseId, sequence])
  @@map("decision_case_events")
}

model DecisionRecommendationArtifact {
  decisions DecisionHumanRecord[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId String @unique @map("case_id") @db.Uuid
  recommendationId String @unique @map("recommendation_id")
  snapshotId String @map("snapshot_id")
  schemaVersion String @map("schema_version")
  contentHash String @map("content_hash") @db.Char(64)
  payloadJson Json @map("payload_json") @db.JsonB
  generatedAt DateTime @map("generated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  case DecisionCase @relation(fields: [caseId, snapshotId], references: [id, snapshotId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([caseId, snapshotId])
  @@map("decision_recommendation_artifacts")
}

model DecisionCaseIdempotencyReceipt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factoryId String @map("factory_id")
  actorId String @map("actor_id") @db.Uuid
  key String
  requestHash String @map("request_hash") @db.Char(64)
  caseId String @map("case_id") @db.Uuid
  responseJson Json @map("response_json") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  case DecisionCase @relation(fields: [caseId, factoryId], references: [id, factoryId], onDelete: Restrict, onUpdate: Restrict, map: "decision_receipts_case_factory_fkey")
  @@unique([factoryId, actorId, key])
  @@map("decision_case_idempotency_receipts")
}

model Experiment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentKey     String           @unique @map("experiment_key")
  name              String
  description       String?
  schemaVersion     String           @default("2.0") @map("schema_version")
  status            ExperimentStatus @default(DRAFT)
  environmentConfig Json             @map("environment_config")
  policyId          String           @map("policy_id") @db.Uuid
  episodeCount      Int              @map("episode_count")
  runIdempotencyKey String?          @map("run_idempotency_key")
  runRequestedAt    DateTime?        @map("run_requested_at") @db.Timestamptz(6)
  createdById       String?          @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  policy            Policy           @relation(fields: [policyId], references: [id], onDelete: Restrict)
  episodes          Episode[]

  @@unique([id, policyId])
  @@unique([createdById, runIdempotencyKey])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc), id(sort: Desc)])
  @@map("experiments")
}

model Policy {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyKey       String                 @map("policy_key")
  version         String
  name            String
  description     String?
  active          Boolean                @default(true)
  configJson      Json?                  @map("config_json")
  createdById     String?                @map("created_by_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  experiments     Experiment[]
  episodes        Episode[]
  recommendations PolicyRecommendation[]

  @@unique([policyKey, version])
  @@map("policies")
}

model Episode {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  episodeKey       String             @unique @map("episode_key")
  experimentId     String             @map("experiment_id") @db.Uuid
  policyId         String             @map("policy_id") @db.Uuid
  episodeIndex     Int                @map("episode_index")
  attempt          Int                @default(1)
  seed             Int
  status           EpisodeStatus      @default(PENDING)
  stepsCompleted   Int                @default(0) @map("steps_completed")
  leaseToken       String?            @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?          @map("lease_expires_at") @db.Timestamptz(6)
  totalCost        Float?             @map("total_cost")
  failureCount     Int?               @map("failure_count")
  replacementCount Int?               @map("replacement_count")
  waitingSteps     Int?               @map("waiting_steps")
  queuedAt         DateTime           @default(now()) @map("queued_at") @db.Timestamptz(6)
  startedAt        DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  failedAt         DateTime?          @map("failed_at") @db.Timestamptz(6)
  cancelledAt      DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  errorCode        String?            @map("error_code")
  errorMessage     String?            @map("error_message")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  experiment       Experiment         @relation(fields: [experimentId, policyId], references: [id, policyId], onDelete: Cascade, map: "episodes_experiment_policy_consistent_fkey")
  policy           Policy             @relation(fields: [policyId], references: [id], onDelete: Restrict)
  observations     FleetObservation[]
  summaries        EpisodeSummary[]

  @@unique([experimentId, policyId, seed])
  @@unique([experimentId, episodeIndex])
  @@index([experimentId, status])
  @@index([status, queuedAt])
  @@index([status, leaseExpiresAt])
  @@index([experimentId, episodeIndex, id])
  @@map("episodes")
}

model FleetObservation {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observationKey String                @unique @map("observation_key")
  episodeId      String                @map("episode_id") @db.Uuid
  attempt        Int                   @default(1)
  step           Int
  schemaVersion  String                @default("2.0") @map("schema_version")
  payloadJson    Json                  @map("payload_json")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  episode        Episode               @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  recommendation PolicyRecommendation?
  stepResult     StepResult?

  @@unique([episodeId, attempt, step])
  @@index([episodeId, attempt, step, id])
  @@map("fleet_observations")
}

model EpisodeSummary {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  episodeId     String   @map("episode_id") @db.Uuid
  attempt       Int      @default(1)
  schemaVersion String   @default("2.0") @map("schema_version")
  payloadJson   Json     @map("payload_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  episode       Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, attempt])
  @@map("episode_summaries")
}

model PolicyRecommendation {
  maintenanceDecision MaintenanceDecision?
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observationId String           @unique @map("observation_id") @db.Uuid
  policyId      String           @map("policy_id") @db.Uuid
  schemaVersion String           @default("2.0") @map("schema_version")
  payloadJson   Json             @map("payload_json")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  observation   FleetObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  policy        Policy           @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId, createdAt(sort: Desc)])
  @@map("policy_recommendations")
}

model StepResult {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observationId     String           @unique @map("observation_id") @db.Uuid
  schemaVersion     String           @default("2.0") @map("schema_version")
  payloadJson       Json             @map("payload_json")
  totalCost         Float            @map("total_cost")
  episodeTerminated Boolean          @map("episode_terminated")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  observation       FleetObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@map("step_results")
}

model User {
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignee")
  createdWorkOrders WorkOrder[] @relation("WorkOrderCreator")
  workOrderEvents WorkOrderEvent[]
  workOrderCompletions WorkOrderCompletion[]
  workOrderReceipts WorkOrderCommandReceipt[]
  factoryMemberships FactoryMembership[] @relation("MemberUser")
  factoryGrants FactoryMembership[] @relation("GrantActor")
  factoryRevocations FactoryMembership[] @relation("RevokeActor")
  maintenanceActions MaintenanceDecisionAction[]
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String       @unique
  fullName     String?      @map("full_name")
  email        String?
  passwordHash String       @map("password_hash")
  role         UserRole     @default(VIEWER)
  active       Boolean      @default(true)
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs    AuditLog[]
  experiments  Experiment[]
  policies     Policy[]

  @@map("users")
}

model AuditLog {
  factoryId String? @map("factory_id")
  factory Factory? @relation(fields: [factoryId], references: [factoryId], onDelete: Restrict, onUpdate: Restrict)
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id")
  action      String
  actorUserId String?    @map("actor_user_id") @db.Uuid
  payloadJson Json?      @map("payload_json")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([factoryId, createdAt], map: "audit_logs_factory_created_idx")
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum ExperimentStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EpisodeStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum UserRole {
  VIEWER
  OPERATOR
  ENGINEER
  ADMIN
}

enum EntityType {
  MAINTENANCE_DECISION
  AUTH
  EXPERIMENT
  POLICY
  EPISODE
  SYSTEM
}

enum MaintenanceDecisionStatus {
  PENDING_REVIEW
  APPROVED
  OVERRIDDEN
  REJECTED
}

model MaintenanceDecision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendationId String @unique @map("recommendation_id") @db.Uuid
  status MaintenanceDecisionStatus @default(PENDING_REVIEW)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  recommendation PolicyRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  actions MaintenanceDecisionAction[]

  @@map("maintenance_decisions")
}

model MaintenanceDecisionAction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionId String @unique @map("decision_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  fromStatus MaintenanceDecisionStatus @default(PENDING_REVIEW) @map("from_status")
  toStatus MaintenanceDecisionStatus @map("to_status")
  reason String?
  selectedAction Json? @map("selected_action")
  recommendationSnapshot Json @map("recommendation_snapshot")
  riskSnapshot Json @map("risk_snapshot")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  decision MaintenanceDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@map("maintenance_decision_actions")
}

model Factory {
 workOrders WorkOrder[]
 factoryId String @id @map("factory_id")
 name String
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
 snapshots FactorySnapshot[]
 memberships FactoryMembership[]
 auditLogs AuditLog[]
 @@map("factories")
}
model FactoryMembership {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 factoryId String @map("factory_id")
 userId String @map("user_id") @db.Uuid
 active Boolean @default(true)
 grantedBy String? @map("granted_by") @db.Uuid
 grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
 grantSource String @map("grant_source")
 revokedBy String? @map("revoked_by") @db.Uuid
 revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
 factory Factory @relation(fields: [factoryId], references: [factoryId], onDelete: Restrict, onUpdate: Restrict)
 user User @relation("MemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 grantActor User? @relation("GrantActor", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
 revokeActor User? @relation("RevokeActor", fields: [revokedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@unique([factoryId,userId])
 @@index([userId,active,factoryId], map: "factory_memberships_user_active_factory_idx")
 @@index([factoryId,active,userId], map: "factory_memberships_factory_active_user_idx")
 @@map("factory_memberships")
}

model WorkOrder {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 factoryId String @map("factory_id")
 sourceCaseId String @map("source_case_id") @db.Uuid
 basisSnapshotId String @map("basis_snapshot_id")
 scheduleId String @map("schedule_id")
 scheduleRevision Int @map("schedule_revision")
 scheduleHash String @map("schedule_hash") @db.Char(64)
 publishedPlanVersion Int @map("published_plan_version")
 basisSnapshotHash String @map("basis_snapshot_hash") @db.Char(64)
 assignmentId String @map("assignment_id")
 machineId String @map("machine_id")
 maintenanceRequestId String @map("maintenance_request_id")
 plannedStartAt DateTime @map("planned_start_at") @db.Timestamptz(6)
 plannedEndAt DateTime @map("planned_end_at") @db.Timestamptz(6)
 sourceTechnicianIds String[] @map("source_technician_ids")
 requirementsJson Json @map("requirements_json") @db.JsonB
 status String @default("UNASSIGNED")
 revision Int @default(1)
 attempt Int @default(1)
 assigneeUserId String? @map("assignee_user_id") @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 blocker String?
 actualStartedAt DateTime? @map("actual_started_at") @db.Timestamptz(6)
 actualCompletedAt DateTime? @map("actual_completed_at") @db.Timestamptz(6)
 verificationJson Json? @map("verification_json") @db.JsonB
 cancelReason String? @map("cancel_reason")
 cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
 createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
 factory Factory @relation(fields:[factoryId], references:[factoryId], onDelete:Restrict, onUpdate:Restrict)
 source DecisionCommit @relation(fields:[sourceCaseId,factoryId,basisSnapshotId,scheduleId,scheduleRevision,scheduleHash,publishedPlanVersion], references:[caseId,factoryId,snapshotId,scheduleId,scheduleRevision,scheduleHash,planVersion], onDelete:Restrict, onUpdate:Restrict)
 assignee User? @relation("WorkOrderAssignee",fields:[assigneeUserId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 creator User @relation("WorkOrderCreator",fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 events WorkOrderEvent[]
 completions WorkOrderCompletion[]
 receipts WorkOrderCommandReceipt[]
 @@unique([id,factoryId])
 @@unique([factoryId,scheduleId,scheduleRevision,assignmentId])
 @@index([factoryId,createdAt(sort:Desc),id(sort:Desc)],map:"work_orders_factory_created_id_idx")
 @@index([factoryId,assigneeUserId,createdAt(sort:Desc),id(sort:Desc)],map:"work_orders_factory_assignee_idx")
 @@index([factoryId,status,createdAt(sort:Desc),id(sort:Desc)],map:"work_orders_factory_status_idx")
 @@map("work_orders")
}
model WorkOrderEvent {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 workOrderId String @map("work_order_id") @db.Uuid
 factoryId String @map("factory_id")
 sequence Int
 actorId String @map("actor_id") @db.Uuid
 command String
 occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
 payloadJson Json @map("payload_json") @db.JsonB
 order WorkOrder @relation(fields:[workOrderId,factoryId],references:[id,factoryId],onDelete:Restrict,onUpdate:Restrict)
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 @@unique([workOrderId,sequence])
 @@map("work_order_events")
}
model WorkOrderCompletion {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 workOrderId String @map("work_order_id") @db.Uuid
 factoryId String @map("factory_id")
 attempt Int
 actorId String @map("actor_id") @db.Uuid
 completedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("completed_at") @db.Timestamptz(6)
 reportJson Json @map("report_json") @db.JsonB
 order WorkOrder @relation(fields:[workOrderId,factoryId],references:[id,factoryId],onDelete:Restrict,onUpdate:Restrict)
